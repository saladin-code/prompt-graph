{
  "name": "prompt-graph",
  "displayName": "PromptGraph",
  "description": "Tracks Kiro AI/VS_Code prompts and their code changes in a visual history",
  "version": "1.0.0",
  "author": {
    "name": "saladin-code",
    "url": "https://github.com/saladin-code"
  },
  "license": "MIT",
  "publisher": "saladin-code",
  "repository": {
    "type": "git",
    "url": "https://github.com/saladin-code/prompt-graph"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "promptGraph",
          "title": "PromptGraph",
          "icon": "media/icon.svg"
        }
      ],
      "panel": [
        {
          "id": "promptGraphPanel",
          "title": "PromptGraph",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "promptGraph": [
        {
          "id": "promptGraph.timeline",
          "name": "Prompt History",
          "type": "webview"
        }
      ],
      "promptGraphPanel": [
        {
          "id": "promptGraph.timelinePanel",
          "name": "Prompt History",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "promptGraph.viewDiff",
        "title": "View Changes",
        "icon": "$(diff)"
      },
      {
        "command": "promptGraph.clearHistory",
        "title": "Clear History",
        "icon": "$(trash)"
      },
      {
        "command": "promptGraph.openFile",
        "title": "Open File"
      }
    ],
    "menus": {}
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "package:extension": "vsce package --readme-path docs/EXTENSION.md"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "sharp": "^0.35.3",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24"
  }
}
